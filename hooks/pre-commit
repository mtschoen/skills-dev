#!/usr/bin/env bash
# Pre-commit gate mirroring the umbrella's hard CI ruff job
# (.github/workflows/lint.yml), so format/lint drift never reaches CI:
#   ruff format --check scripts/ tests/ ci/   +   ruff check scripts/ tests/ ci/
#
# Umbrella-owned code only -- each skill submodule owns its own gate, matching the
# CI scoping (pyproject.toml excludes submodule trees). The on-save hook
# (.claude/hooks/ruff_on_save.py) auto-formats during Claude sessions; this is the
# author/machine-independent backstop.
#
# The following tools stay CI-only: shellcheck, markdownlint, validate-skills,
# and aislop. Shellcheck is deliberately NOT run here: on Windows the .sh files are checked
# out with CRLF, which shellcheck flags as SC1017 ("literal carriage return") --
# a false positive that would block every commit. CI runs it on Linux (LF) where
# it is meaningful. The repo policy already treats shellcheck as optional locally.
#
# core.hooksPath is per-clone local config (not committed). Enable once per clone:
#   git config core.hooksPath hooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
pin_file="$repo_root/ci/ruff-version"
if [ ! -r "$pin_file" ]; then
  echo "pre-commit: cannot read the ruff pin at ci/ruff-version." >&2
  exit 1
fi
pinned="$(tr -d '[:space:]' < "$pin_file")"

# Select ruff, always at exactly the pinned version (ci/ruff-version): uvx first,
# then a PATH ruff or a python module ruff that reports that exact version.
# An unpinned ruff is never run.
RUFF=()
if command -v uvx >/dev/null 2>&1; then
  RUFF=(uvx "ruff@$pinned")
elif command -v ruff >/dev/null 2>&1 && [ "$(ruff --version 2>/dev/null)" = "ruff $pinned" ]; then
  RUFF=(ruff)
elif command -v python >/dev/null 2>&1 && [ "$(python -m ruff --version 2>/dev/null)" = "ruff $pinned" ]; then
  RUFF=(python -m ruff)
elif command -v python3 >/dev/null 2>&1 && [ "$(python3 -m ruff --version 2>/dev/null)" = "ruff $pinned" ]; then
  RUFF=(python3 -m ruff)
else
  echo "pre-commit: ruff $pinned (ci/ruff-version) not available; run 'uv tool install ruff==$pinned' or 'pip install ruff==$pinned'." >&2
  exit 1
fi

fail=0
if ! "${RUFF[@]}" format --check scripts/ tests/ ci/; then
  echo "pre-commit: 'ruff format --check scripts/ tests/ ci/' failed -- run 'ruff format scripts/ tests/ ci/'." >&2
  fail=1
fi
if ! "${RUFF[@]}" check scripts/ tests/ ci/; then
  echo "pre-commit: 'ruff check scripts/ tests/ ci/' failed." >&2
  fail=1
fi

exit "$fail"
